# Copy to .env and replace every placeholder. Never commit .env.
MYSQL_DATABASE=ticket_booking
MYSQL_USER=booking_app
MYSQL_ROOT_PASSWORD=replace_with_your_mysql_root_password
MYSQL_PASSWORD=replace_with_your_mysql_app_password
RABBITMQ_USERNAME=booking
RABBITMQ_PASSWORD=replace_with_your_rabbitmq_password
# Base64-encoded random secret containing at least 32 decoded bytes.
JWT_SECRET=replace_with_your_base64_encoded_random_secret
DS_api=replace_with_your_deepseek_api_key
